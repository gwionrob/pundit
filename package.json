{
  "name": "pundit",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch --env-file-if-exists=.env src/index.ts\" \"vite\"",
    "build": "vite build",
    "build:cli": "tsx scripts/build-cli.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "croner": "^10.0.1",
    "hono": "^4.13.16",
    "react": "19.2",
    "react-dom": "19.2",
    "tsx": "4.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "prettier": "3.9.10",
    "react-router": "^7.18.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "description": "Pundit: weekly bulletins for Fantasy Premier League mini-leagues. Share to WhatsApp, Telegram or Discord",
  "bin": {
    "pundit": "bin/pundit.js"
  }
}
