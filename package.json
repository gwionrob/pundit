{
  "name": "pundit-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "croner": "^10.0.1",
    "hono": "4.12",
    "zod": "4.3",
    "tsx": "4.21"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "description": "Pundit: weekly bulletins for Fantasy Premier League mini-leagues. Share to WhatsApp, Telegram or Discord",
  "bin": {
    "pundit": "bin/pundit.js"
  }
}
