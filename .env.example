# Public URL of the app (used in share links and Telegram deep links).
# In dev this is the Vite server (5173), which proxies API calls to PORT.
APP_URL=http://localhost:5173
PORT=3000
# SQLite file location
DATABASE_PATH=./data/app.db
# Secret used to sign session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
# (Fly.io, Railway, Render, nginx). Used for login rate limiting.
TRUST_PROXY=false

# Optional: Telegram bot (create via @BotFather). Enables automatic Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional: Resend API key for email notifications ("your bulletin is ready").
# Without it, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Pundit <pundit@example.com>"

# Comma-separated emails of accounts that can open the read-only /admin dashboard.
# Sign up with the account first: these emails can't be used to create new accounts.
ADMIN_EMAILS=
